# DeepTerm Environment Variables
# Copy this file to .env.local for development

# Security Configuration
VITE_ENABLE_DEBUG_LOGS=false
VITE_API_RATE_LIMIT=10

# Google API Configuration (Users provide their own keys)
# VITE_GEMINI_API_KEY=your_gemini_api_key_here (NOT RECOMMENDED - users should provide their own)

# Analytics (Optional)
# VITE_GA_TRACKING_ID=your_google_analytics_id

# Security Notes:
# - Never commit actual API keys to version control
# - Users should provide their own Gemini API keys
# - Use environment variables for configuration only
